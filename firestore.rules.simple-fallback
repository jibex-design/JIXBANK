// ONLY FOR DEBUGGING. NOT SAFE. Any signed-in user can read and edit everything.
// Use it for 2 minutes to find out whether the strict rules are the problem,
// then switch back to firestore.rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
